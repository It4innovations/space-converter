@PACKAGE_INIT@

# Provide the targets file
include("${CMAKE_CURRENT_LIST_DIR}/space_converterTargets.cmake")

# Optionally check for dependencies if needed by downstream projects
# These are the same dependencies that space_converter needs
if(@WITH_MPI@)
    find_package(MPI QUIET)
endif()

if(@WITH_OPENMP@)
    find_package(OpenMP QUIET)
endif()

if(@WITH_VTK@)
    find_package(VTK QUIET COMPONENTS
        CommonCore
        CommonDataModel
        IOLegacy
        IOXML
        IOParallelXML
    )
endif()

if(@WITH_HDF5@)
    find_package(HDF5 QUIET COMPONENTS C)
endif()

check_required_components(space_converter)
